
import 'package:flutter/material.dart';

class CircularMouseCursor extends StatefulWidget {
  final Widget child;

  const CircularMouseCursor({
    super.key,
    required this.child,
  });

  @override
  State<CircularMouseCursor> createState() =>
      _CircularMouseCursorState();
}

class _CircularMouseCursorState
    extends State<CircularMouseCursor> {
  Offset? pointerPosition;

  @override
  Widget build(BuildContext context) {
    return MouseRegion(
      cursor: SystemMouseCursors.none,
      onHover: (event) {
        setState(() {
          pointerPosition = event.localPosition;
        });
      },
      onExit: (_) {
        setState(() {
          pointerPosition = null;
        });
      },
      child: Stack(
        fit: StackFit.expand,
        children: [
          widget.child,

          if (pointerPosition != null)
            Positioned(
              left: pointerPosition!.dx - 24,
              top: pointerPosition!.dy - 24,
              child: IgnorePointer(
                child: Container(
                  width: 48,
                  height: 48,
                  decoration: BoxDecoration(
                    shape: BoxShape.circle,
                    color: const Color(0x558E68FF),
                    border: Border.all(
                      color: const Color(0xFFB69AFF),
                      width: 2,
                    ),
                    boxShadow: const [
                      BoxShadow(
                        color: Color(0x998E68FF),
                        blurRadius: 22,
                        spreadRadius: 4,
                      ),
                    ],
                  ),
                  child: Center(
                    child: Container(
                      width: 7,
                      height: 7,
                      decoration: const BoxDecoration(
                        color: Colors.white,
                        shape: BoxShape.circle,
                      ),
                    ),
                  ),
                ),
              ),
            ),
        ],
      ),
    );
  }
}
